# Copy to .env for local development, or set these as "Secrets" in Replit.

# Required: a Postgres connection string.
# On Replit: open the "Database" pane and enable Postgres — DATABASE_URL is set for you.
# Elsewhere: use a free Postgres like Neon (neon.tech) or Supabase (supabase.com).
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Required in production: a long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials
# — OAuth client ID, type "Web application", authorized redirect URI:
# https://YOUR-DOMAIN/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth (create an app at https://developers.facebook.com/apps
# — add "Facebook Login" product, valid OAuth redirect URI:
# https://YOUR-DOMAIN/auth/facebook/callback)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

NODE_ENV="production"
PORT=3000
