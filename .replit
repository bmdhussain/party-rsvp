modules = ["nodejs-20", "python-base-3.13", "postgresql-16"]
run = "npm start"
entrypoint = "server.js"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 NODE_ENV=production npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
BREVO_REPLY_TO = "organizer@rsvpfor.com"
BREVO_SENDER_EMAIL = "organizer@rsvpfor.com"
BREVO_SENDER_NAME = "JustRSVP"
